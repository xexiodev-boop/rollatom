{
  "name": "rollatom",
  "version": "1.1.0",
  "description": "A dependency-free dice-notation parser and roller for the web platform.",
  "license": "MIT",
  "author": "ajdionisio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xexiodev-boop/rollatom.git"
  },
  "bugs": {
    "url": "https://github.com/xexiodev-boop/rollatom/issues"
  },
  "homepage": "https://github.com/xexiodev-boop/rollatom#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json && vitest run",
    "size": "node scripts/size.mjs",
    "smoke": "node scripts/smoke.mjs",
    "worker-check": "node scripts/worker-check.mjs",
    "playground": "npm run build && node scripts/playground.mjs",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "dice",
    "dice-notation",
    "rpg",
    "ttrpg",
    "roller",
    "random"
  ],
  "devDependencies": {
    "@types/node": "^26.4.1",
    "fast-check": "^4.5.3",
    "playwright": "^1.63.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
